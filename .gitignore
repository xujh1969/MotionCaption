# Dependencies and build output
node_modules/
dist/

# Rust / Tauri build output (always regenerable, hundreds of MB)
**/src-tauri/target/
**/src-tauri/gen/

# Test and bundler caches
coverage/
.vite/
*.tsbuildinfo
.eslintcache

# Local test media assets (large, user's own test material — never commit)
/tests/

# Superpowers transient files only; plans and reports remain tracked.
.superpowers/
.superpowers/**/tmp/
.superpowers/**/*.tmp

# Local operating-system and package-manager noise
.DS_Store
Thumbs.db
*.log
vite.config.ts.timestamp-*.mjs

# WorkBuddy workspace data
.workbuddy/

# Local user test material (srt/md working files — never commit)
/content/
