{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MotionCaption",
  "version": "../package.json",
  "identifier": "com.motioncaption.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:8011",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MotionCaption",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../src/agent/generated/componentManifest.json",
      "../skill/SKILL.md",
      "../skill/references",
      "../skill/scripts",
      "../node_modules/ffmpeg-static/ffmpeg.exe"
    ]
  }
}
